else
    echo "Existing Waybar stylesheet found; leaving it untouched."
fi

# ===========================================================================
# Screenshot helper
# ===========================================================================

log "Installing screenshot helper"

cat > "$USER_HOME/.local/bin/hypr-screenshot" <<'EOF'
#!/usr/bin/env bash

set -euo pipefail

mkdir -p "$HOME/Pictures/Screenshots"

region="$(slurp)" || exit 0

file="$HOME/Pictures/Screenshots/$(date +%Y%m%d-%H%M%S).png"

grim -g "$region" "$file"

wl-copy --type image/png < "$file"

notify-send \
    "Screenshot saved" \
    "$file"
EOF

chmod +x "$USER_HOME/.local/bin/hypr-screenshot"

# ===========================================================================
# TTY1 -> Hyprland startup
# ===========================================================================

log "Configuring Hyprland to start after tty1 login"

BASH_PROFILE="$USER_HOME/.bash_profile"

touch "$BASH_PROFILE"

append_if_missing \
    "$BASH_PROFILE" \
    "# ARCH-HYPRLAND-BOOTSTRAP" \
    '# ARCH-HYPRLAND-BOOTSTRAP
#
# Start Hyprland automatically after the user logs into tty1.
#
# This does NOT automatically log the user in.
# The user must still enter their username and password.

if [[ "$(tty)" == "/dev/tty1" ]] && uwsm check may-start >/dev/null 2>&1; then
    exec uwsm start hyprland.desktop
fi'

# ===========================================================================
# Local PATH
# ===========================================================================

log "Configuring local executable PATH"

append_if_missing \
    "$USER_HOME/.bashrc" \
    "# ARCH-HYPRLAND-LOCAL-BIN" \
    '# ARCH-HYPRLAND-LOCAL-BIN
export PATH="$HOME/.local/bin:$PATH"'

# ===========================================================================
# Permissions
# ===========================================================================

log "Fixing configuration ownership"

sudo chown -R "$USER_NAME:$(id -gn)" \
    "$USER_HOME/.config/hypr" \
    "$USER_HOME/.config/fuzzel" \
    "$USER_HOME/.config/mako" \
    "$USER_HOME/.config/waybar" \
    "$USER_HOME/.config/foot" \
    "$USER_HOME/.local/bin" \
    "$BASH_PROFILE"

# ===========================================================================
# Configuration summary
# ===========================================================================

echo
echo "=============================================================="
echo " Hyprland bootstrap complete"
echo "=============================================================="
echo
echo "Installed:"
echo
echo "  Hyprland"
echo "  UWSM"
echo "  Hyprlock"
echo "  Hypridle"
echo "  Waybar"
echo "  Fuzzel"
echo "  Mako"
echo "  Foot"
echo "  PipeWire / WirePlumber"
echo "  NetworkManager"
echo "  Bluetooth"
echo "  wl-clipboard / cliphist"
echo "  grim / slurp"
echo
echo "Hyprland configuration:"
