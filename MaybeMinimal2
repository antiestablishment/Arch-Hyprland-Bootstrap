EOF
else
    echo "Existing Waybar config found; leaving it untouched."
fi

if [[ ! -e "$USER_HOME/.config/waybar/style.css" ]]; then
    log "Creating neutral Waybar stylesheet"

    cat > "$USER_HOME/.config/waybar/style.css" <<'EOF'
